---
import { SINCE_YEAR, PHONE_TEL, PHONE_DISPLAY } from "../data/site";
---

<footer class="site-footer">
  <div class="wrap">
    <p class="footer-brand">
      <img class="logo-mark" src="/logo-accent.png" alt="" aria-hidden="true" />
      <strong>St. Mary’s Painting Works</strong>
      <span>· Since {SINCE_YEAR}</span>
    </p>
    <nav aria-label="Footer">
      <a href="#services">Services</a>
      <a href="#gallery">Gallery</a>
      <a href="#clips">Videos</a>
      <a href="#how-it-works">How it works</a>
      <a href="#contact">Contact</a>
    </nav>
    <p class="small">
      <a href={PHONE_TEL}>{PHONE_DISPLAY}</a>
    </p>
  </div>
</footer>
