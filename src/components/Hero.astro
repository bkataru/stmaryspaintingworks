---
import { PHONE_TEL, PHONE_DISPLAY, HERO_HOURS, AREA_SHORT, OWNER, waLink } from "../data/site";

const PHONE_PATH =
  "M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z";
const CHAT_PATH =
  "M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z";
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <h1>Painting, repairs and finishing for flats, houses and offices.</h1>
      <p class="hero-sub">
        {OWNER} visits the site, then quotes after he has seen the job. Own crews, no brokers.
      </p>
      <div class="btn-row">
        <a class="btn btn-call" href={PHONE_TEL}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={PHONE_PATH} />
          </svg>
          Call&nbsp;{PHONE_DISPLAY}
        </a>
        <a
          class="btn btn-wa"
          href={waLink(
            "Hi St. Mary’s Painting Works, I need painting in ____ (area). When can you visit?",
          )}
          target="_blank"
          rel="noopener"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={CHAT_PATH} />
          </svg>
          WhatsApp us
        </a>
      </div>
      <p class="small hero-meta">{HERO_HOURS}</p>
      <p class="small hero-meta">{AREA_SHORT}</p>
    </div>
    <div class="hero-collage">
      <figure class="hero-photo">
        <picture>
          <source
            srcset="/gallery-webp/hero-finished-exterior-320.webp 320w, /gallery-webp/hero-finished-exterior-480.webp 480w, /gallery-webp/hero-finished-exterior-720.webp 720w, /gallery-webp/hero-finished-exterior.webp 750w"
            sizes="(max-width: 639px) 92vw, 560px"
            type="image/webp"
          />
          <img
            src="/gallery/hero-finished-exterior.jpg"
            alt=""
            width="750"
            height="1000"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <figcaption>New exterior paint</figcaption>
      </figure>
    </div>
  </div>
</section>
