---
import { PHONE_TEL, waLink } from "../data/site";

const PHONE_PATH =
  "M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z";
const CHAT_PATH =
  "M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z";
---

<nav class="sticky-bar" aria-label="Quick contact">
  <div class="bar-sections">
    <a class="bar-section" href="#services" aria-label="Go to services">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3.5l2.1 6.4 6.4 2.1-6.4 2.1L12 20.5l-2.1-6.4L3.5 12l6.4-2.1L12 3.5z" />
      </svg>
      <span class="bar-section-label">Services</span>
    </a>
    <a class="bar-section" href="#gallery" aria-label="Go to gallery">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 5h16a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1z" />
        <path d="M3 17l5-5 4 4 3-3 6 6" />
        <path d="M15.5 8.5h.01" />
      </svg>
      <span class="bar-section-label">Gallery</span>
    </a>
    <a class="bar-section" href="#clips" aria-label="Go to clips">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9" />
        <path d="M10 8l6 4-6 4V8z" />
      </svg>
      <span class="bar-section-label">Videos</span>
    </a>
    <a class="bar-section" href="#contact" aria-label="Go to contact">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M4 6h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V7a1 1 0 011-1z" />
        <path d="M3 7l9 6 9-6" />
      </svg>
      <span class="bar-section-label">Contact</span>
    </a>
  </div>
  <div class="bar-actions">
    <a class="bar-call" href={PHONE_TEL} aria-label="Call St. Mary’s Painting Works">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={PHONE_PATH} />
      </svg>
      <span class="bar-action-label">Call</span>
    </a>
    <a
      class="bar-wa"
      href={waLink("Hi St. Mary’s Painting Works, I need a painter in ____.")}
      target="_blank"
      rel="noopener"
      aria-label="WhatsApp St. Mary’s Painting Works"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={CHAT_PATH} />
      </svg>
      <span class="bar-action-label">WhatsApp</span>
    </a>
  </div>
</nav>
